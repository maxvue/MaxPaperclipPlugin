    "ui": "./dist/ui/"
  },
  "scripts": {
    "build": "node ./esbuild.config.mjs",
    "dev": "node ./esbuild.config.mjs --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "overrides": {
    "@paperclipai/shared": "file:/home/johnattas/GitHub/paperclip/packages/shared"
  },
  "pnpm": {
    "overrides": {
      "@paperclipai/shared": "file:/home/johnattas/GitHub/paperclip/packages/shared"
    }
  },
  "dependencies": {
    "@paperclipai/plugin-sdk": "file:.paperclip-sdk/paperclipai-plugin-sdk-1.0.0.tgz",
    "@paperclipai/shared": "file:/home/johnattas/GitHub/paperclip/packages/shared"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.16.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  },
