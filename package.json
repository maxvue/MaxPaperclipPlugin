{
  "name": "@max/paperclip-plugin",
  "version": "1.1.0",
  "description": "Plugin consolidado MaxPaperclipPlugin: Ícones, Tradutor PT-BR, Aba de Tarefas, Auto-Save e Editor de Capacidades.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/worker.js",
    "./manifest": "./dist/manifest.js",
    "./ui": "./dist/ui/index.js"
  },
  "files": [
    "dist"
  ],
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "scripts": {
    "build": "node ./esbuild.config.mjs",
    "dev": "node ./esbuild.config.mjs --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "overrides": {
    "@paperclipai/shared": "file:.paperclip-sdk/paperclipai-shared-0.3.1.tgz"
  },
  "devDependencies": {
    "@paperclipai/plugin-sdk": "file:.paperclip-sdk/paperclipai-plugin-sdk-1.0.0.tgz",
    "@paperclipai/shared": "file:.paperclip-sdk/paperclipai-shared-0.3.1.tgz",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
